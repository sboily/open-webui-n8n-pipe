{
  "name": "Open-WebUI echo (n8n pipe example)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "openwebui",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5f0b8a1e-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ output: 'Echo: ' + $json.body.chatInput }) }}",
        "options": {}
      },
      "id": "5f0b8a1e-0000-4000-8000-000000000002",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [240, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  },
  "settings": {"executionOrder": "v1"}
}
